# Copy this file to .env (already git-ignored) and fill in every value.
#
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_VAULT_URL come from whichever
# Key Vault + Entra App Registration you provision for this case study (see
# README "Prerequisites"). AZURE_CLIENT_SECRET must be generated yourself,
# e.g. via Azure Portal > App registrations > <your app> > Certificates &
# secrets > New client secret -- paste the value here directly. This file
# (and .env) never needs to be shared with anyone/anything driving this
# repo on your behalf.
AZURE_TENANT_ID=REPLACE-WITH-ENTRA-TENANT-ID
AZURE_CLIENT_ID=REPLACE-WITH-ENTRA-CLIENT-ID
AZURE_VAULT_URL=https://REPLACE-WITH-YOUR-VAULT.vault.azure.net/
AZURE_CLIENT_SECRET=
